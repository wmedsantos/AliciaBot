      "name": "★ Day 6: Authentication (JWT)",
      "item": [
        {
          "name": "Sign Up (Create User Account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"email\": \"amanda@beleza.com\",\n  \"password\": \"SecurePassword123\",\n  \"role\": \"Owner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login (Get JWT Token)",
          "request": {
            "method": "POST",
