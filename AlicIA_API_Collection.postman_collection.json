          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/google/callback?code=PASTE_CODE_HERE&state={{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["oauth", "google", "callback"],
              "query": [
