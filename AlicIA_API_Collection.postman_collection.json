    {
      "name": "Google Calendar Integration",
      "item": [
        {
          "name": "Start OAuth Flow",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/google/start/{{tenantId}}",
